{
  "schema": "artcraft.app.v1",
  "id": "io.github.jessenaiman.magic",
  "name": "Magic Studio",
  "slug": "magic",
  "description": "Song-driven storyboard, animation, kinetic lyrics, and FilmCraft studio coordinator over the ArtCraft suite",
  "license": "LicenseRef-Magic-Studio-NonResale",
  "repository": "https://github.com/jessenaiman/magic",
  "binaries": {
    "desktop": "magic",
    "cli": "magic-cli",
    "mcp": "magic-mcp"
  },
  "control": {
    "flag": "--control",
    "env": "MAGIC_CONTROL_PORT",
    "default_port": 9876,
    "token_env": "MAGIC_CONTROL_TOKEN",
    "mcp_command": [
      "magic-cli",
      "mcp"
    ],
    "mcp_connect_command": [
      "magic-cli",
      "mcp",
      "--connect",
      "127.0.0.1:9876"
    ],
    "mcp_headless_command": [
      "magic-cli",
      "mcp",
      "--headless"
    ]
  },
  "mime_types": [
    {
      "mime": "application/vnd.artcraft.magic+json",
      "extensions": [
        "magic"
      ]
    }
  ],
  "craft_dependencies": {
    "ui_and_cli": [
      "filmcraft",
      "effectcraft",
      "designcraft",
      "photocraft",
      "vectorcraft"
    ],
    "cli_headless_only": [
      "anicraft-cli",
      "texturecraft-cli"
    ]
  },
  "license_file": "LICENSE",
  "commercial_output_allowed": true,
  "software_resale_allowed": false
}
